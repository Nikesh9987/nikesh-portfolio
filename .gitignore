.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js ─────────────────────────────────────────────────────────────────
.next/
out/
build/

# ── Environment variables — NEVER commit ────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Vercel ──────────────────────────────────────────────────────────────────
.vercel

# ── Netlify ─────────────────────────────────────────────────────────────────
.netlify/

